{
    "version": "0.2.0",
    "compounds": [
        {
            "name": "All",
            "configurations": [
                "Wyoming ASR",
                "Wyoming TTS",
                "Demo (Next.js)"
            ]
        }
    ],
    "configurations": [
        {
            "name": "Wyoming ASR",
            "type": "debugpy",
            "request": "launch",
            "module": "wyoming_audiocpp_asr",
            "args": [
                "--config",
                "config.devcontainer.json"
            ],
            "cwd": "/workspaces",
            "console": "integratedTerminal",
            "python": "/workspaces/.venv/bin/python",
            "justMyCode": true
        },
        {
            "name": "Wyoming TTS",
            "type": "debugpy",
            "request": "launch",
            "module": "wyoming_audiocpp_tts",
            "args": [
                "--config",
                "config.devcontainer.json"
            ],
            "cwd": "/workspaces",
            "console": "integratedTerminal",
            "python": "/workspaces/.venv/bin/python",
            "justMyCode": true
        },
        {
            "name": "Demo (Next.js)",
            "type": "node",
            "request": "launch",
            "program": "/workspaces/wyoming_audiocpp_demo/node_modules/.bin/next",
            "args": [
                "dev",
                "--port",
                "11000"
            ],
            "cwd": "/workspaces/wyoming_audiocpp_demo",
            "console": "integratedTerminal",
            "localRoot": "/workspaces/wyoming_audiocpp_demo/node_modules/.cache/next",
            "skipFiles": [
                "**/node_modules/**",
                "<node_internals>/**"
            ]
        }
    ]
}
